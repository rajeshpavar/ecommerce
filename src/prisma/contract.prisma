// use prisma-8

enum typeOfUser {
  USER 
  ADMIN
}

enum typeOfAddress {
  HOME
  OFFICE
  OTHER
}

enum OrderStatus {
  PENDING
  SHIPPED
  DELIVERED
}

enum typePayment {
  UPI
  CARD
  CASH
}

enum typeOfCategory {
  // Block keys and attributes
CLOTHES
ELECTRONICS
FOOD
BEAUTY
FURNITURE
BOOKS
OTHER
}


model User {
  id        String    @id @default(uuid())
  name      String 
  email     String    @unique
  password  String 
  role      typeOfUser @default(USER)
  gender    String    @default("male")
  createdAt DateTime  @default(now())
  address   Address[]
  cart      Cart?
  orders    Order[]

  @@rls
}

model Address {
  id             String   @id @default(uuid())
  type           typeOfAddress @default(HOME)
  buildingNumber String 
  buildingName   String
  area           String
  city           String
  pincode        String
  userId         String
  user           User     @relation(fields: [userId], references: [id])

  @@rls
}

model Product {
  id          String @id @default(uuid())
  externalId  Int? @unique
  brand       String
  title       String
  description String
  stock       Int
  price       Decimal
  categoryId String
  
  category  Category @relation(references: [id],fields: [categoryId])
  cartItems   CartItem[]
  orderItems  OrderItem[]
  images  ProductImage[]
  reviews Review[]
  @@rls
}

model ProductImage{
  id String @id @default(uuid())
  url String
 productId String 
 product Product @relation(references: [id],fields: [productId],onDelete:Cascade) 

 @@rls
}

model  Review {
  id String @id @default(uuid())
  reviewerName String 
  comment String
  productId String
  product Product @relation(references: [id],fields: [productId],onDelete:Cascade)
  @@rls
}

model Category{
 id      String     @id @default(uuid())
 type  typeOfCategory @default(OTHER)

@@rls
}

model Cart {
  id        String     @id @default(uuid())
  cartItems CartItem[]
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])

  @@rls
}

model CartItem {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id])
  quantity  Int

  @@unique([cartId, productId])
  @@rls
}

model Order {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  status     OrderStatus @default(PENDING)  
  orderItems OrderItem[]
  payment    Payment?

  @@rls
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int

  @@rls
}

model Payment {
  id      String     @id @default(uuid())
  orderId String     @unique
  order   Order      @relation(fields: [orderId], references: [id])
  amount  Decimal
  type    typePayment

  @@rls
}


